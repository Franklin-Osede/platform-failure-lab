terraform {
  # S3 native locking (use_lockfile) needs 1.11+.
  required_version = ">= 1.11.0, < 2.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.12"
    }
  }

  # Partial configuration: bucket and region come from backend.hcl
  # (generated by `make bootstrap`, not committed).
  backend "s3" {
    key          = "platform-failure-lab/infra/terraform.tfstate"
    use_lockfile = true # lock = <key>.tflock object in the same bucket; no DynamoDB
    encrypt      = true
  }
}
